# =========================================================================
# Influencer Hub — environment template. Copy to .env and keep it private.
# Values below are safe defaults or placeholders; never commit .env.
# =========================================================================

# ---- Database ----
HUB_DB_PATH=influencer_hub/hub.sqlite3

# ---- Amazon Associates / Creators API ----
AMAZON_ASSOCIATE_TAG=mama086-21
# Public application identifier for the SMART_BUY Creators API application.
AMAZON_CREATORS_API_CLIENT_ID=amzn1.application-oa2-client.83229d9d14664351be9fc2059038a4f2
# Obtain the secret from Associates Central; it must not be committed.
AMAZON_CREATORS_API_CLIENT_SECRET=
# Use the exact credential version shown in Associates Central. The default
# below is configurable; change it if your SMART_BUY credential shows another.
AMAZON_CREATORS_API_VERSION=3.2
AMAZON_CREATORS_API_MARKETPLACE=www.amazon.in
AMAZON_CREATORS_API_ENDPOINT=https://creatorsapi.amazon/catalog/v1
AMAZON_CREATORS_API_APP_NAME=SMART_BUY
AMAZON_CREATORS_API_TIMEOUT=15
# Optional: your own short HTTPS hostname routed to the Flask dashboard.
# Example: https://amz.your-domain.in (blank leaves canonical Amazon links).
AMAZON_SHORT_LINK_BASE_URL=
HYPD_STORE_ID=93944

# ---- Telegram (already authorized Telethon user session) ----
TELEGRAM_API_ID=33595682
# Treat API_HASH as a secret and set it on the VM only. Never put it in Git.
TELEGRAM_API_HASH=
TELEGRAM_SESSION=bestgaa_fresh
TELEGRAM_SESSION_ISOLATION=true
TELEGRAM_SOURCE_REQUEST_SPACING=0.25
# Comma-separated known output channels/groups to exclude from source ingestion.
TELEGRAM_OUTPUT_CHANNELS=
BOT_TOKEN=
BOT_USERNAME=your_posting_bot

# ---- EarnKaro (required to convert Flipkart/Shopsy/Myntra/Ajio links) ----
# API key is a JWT. Publisher ID is used for conversion provenance checks.
EARNKARO_API_KEY=
EARNKARO_PUBLISHER_ID=
EARNKARO_API_URL=https://ekaro-api.affiliaters.in/api/converter/public

# ---- Shared deal pool (optional; joined Telegram dialogs are read directly) ----
# Comma-separated Telegram usernames or t.me links. Private invite URLs are
# treated as source hints only; the worker never checks invite links.
SHARED_SOURCES=
DUMMY_SOURCES=

# ---- WhatsApp hub (Node/Baileys multi-session service) ----
WA_HUB_URL=http://127.0.0.1:8088
WA_HUB_TOKEN=

# ---- Ops / monitoring ----
OPS_TELEGRAM_CHANNEL=
VM_WATCH_INTERVAL=300

# ---- Continuous worker ----
DEAL_WORKER_POLL_INTERVAL=30
DEAL_WORKER_BATCH_SIZE=100
DEAL_WORKER_INITIAL_BATCH_SIZE=10
DEAL_WORKER_MAX_BACKOFF=900

# ---- Pipeline pacing ----
HUB_QUEUE_WORKERS=4
HUB_POST_QUIET_START=02:00
HUB_POST_QUIET_END=06:00
