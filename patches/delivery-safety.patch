+  assert.equal(isValidSessionKey(''), false)
+  assert.equal(isValidSessionKey('x'.repeat(129)), false)
+  assert.equal(isValidSessionKey('bad\nkey'), false)
+  assert.equal(isValidSessionKey({ key: 'not a string' }), false)
+})
