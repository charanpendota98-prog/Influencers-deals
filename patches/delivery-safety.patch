+  assert.equal(bearerTokenMatches(`Bearer ${strongToken}x`, strongToken), false)
+  assert.equal(bearerTokenMatches('', strongToken), false)
+  assert.equal(bearerTokenMatches(`Bearer ${strongToken}`, ''), false)
+})
+
