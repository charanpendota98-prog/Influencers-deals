+{% set policy = category_preference_view(policy_profile) %}
+<fieldset class="product-policy" data-creator="{{ policy_profile.id }}" style="margin:16px 0;padding:16px;border:1px solid var(--border, #ddd);border-radius:12px;">
+  <legend><strong>🎯 Only what {{ policy_profile.name }} wants</strong></legend>
+  {% if policy.error %}<p role="alert">⚠ {{ policy.error }} Delivery is held until valid preferences are saved.</p>{% endif %}
+  <p class="hint">Saved mode: <strong>{{ policy.mode }}</strong>. Strict changes apply only after Save. Other creators are not changed.</p>
+  <label>Delivery style
+    <select name="category_mode">
+      <option value="strict" {% if policy.mode == 'strict' or not policy_profile.category_preferences %}selected{% endif %}>Strict — selected products only; hold unknowns</option>
+      <option value="legacy" {% if policy.mode == 'legacy' and policy_profile.category_preferences %}selected{% endif %}>Flexible — previous category behaviour</option>
+    </select>
+  </label>
+  <label>Posts containing multiple product types
+    <select name="mixed_products">
+      <option value="block" {% if policy.mixed == 'block' %}selected{% endif %}>Hold if another product type is outside my selection</option>
+      <option value="allow" {% if policy.mixed == 'allow' %}selected{% endif %}>Allow if at least one selected product type matches</option>
+    </select>
+  </label>
+  <details style="margin-top:12px;">
+    <summary>Optional: never post these categories / specific product phrases</summary>
+    <p class="hint">Exclusions win over allowed categories. Phrase filters apply to product text, not URLs or common channel footers.</p>
+    <div style="display:flex;flex-wrap:wrap;gap:12px;">
+      {% for key, label, hint in product_category_choices if key != 'all' %}
+        <label><input type="checkbox" name="excluded_categories" value="{{ key }}"
+          {% if key in product_category_picked(policy.excluded_categories|join(',')) %}checked{% endif %} /> Never: {{ label }}</label>
+      {% endfor %}
+    </div>
+    <label>Must contain at least one product phrase (optional, comma separated)
+      <input name="required_keywords" maxlength="1600" value="{{ policy.required_keywords|join(', ') }}" placeholder="smartphone, earbuds" style="width:100%;box-sizing:border-box;" />
+    </label>
+    <label>Never contain any of these phrases (optional, comma separated)
+      <input name="blocked_keywords" maxlength="1600" value="{{ policy.blocked_keywords|join(', ') }}" placeholder="refurbished, renewed, used" style="width:100%;box-sizing:border-box;" />
+    </label>
+    <p class="hint">Up to 20 literal phrases per field; 80 characters per phrase. No regex. In flexible mode these extra restrictions are inactive.</p>
+  </details>
+  <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border, #ddd);">
+    <label>Try a deal before saving
+      <textarea class="policy-sample" rows="3" maxlength="20000" placeholder="Paste product text or a deal" style="width:100%;box-sizing:border-box;"></textarea>
