+(function () {
+  'use strict';
+  var panel = document.currentScript.previousElementSibling;
+  var form = panel.closest('form');
+  var draft = panel.querySelector('.policy-preview-draft');
+  var saved = panel.querySelector('.policy-preview-saved');
+  var result = panel.querySelector('.policy-result');
+  var categoryBoxes = Array.from(form.querySelectorAll('input[name="categories"]'));
+  categoryBoxes.forEach(function (box) {
+    box.addEventListener('change', function () {
+      if (!box.checked) { return; }
+      categoryBoxes.forEach(function (other) {
+        if ((box.value === 'all' && other !== box) || (box.value !== 'all' && other.value === 'all')) { other.checked = false; }
+      });
+    });
+  });
+  async function check(useSaved) {
+    var text = panel.querySelector('.policy-sample').value;
+    var payload = {text: text};
+    if (useSaved) {
+      payload.creator_id = panel.dataset.creator;
+      var channel = panel.querySelector('.policy-channel').value;
+      if (channel) { payload.channel_id = channel; }
+    } else {
+      var picked = categoryBoxes.filter(function (box) { return box.checked; }).map(function (box) { return box.value; });
+      var free = form.querySelector('input[name="categories_text"]');
+      payload.categories = picked.length ? picked.join(',') : (free ? free.value : '');
+      if (!payload.categories.trim() && panel.querySelector('[name="category_mode"]').value === 'strict') {
+        result.textContent = 'Select a category, or explicitly choose All categories.';
+        return;
+      }
+      payload.preferences = {
+        mode: panel.querySelector('[name="category_mode"]').value,
+        mixed: panel.querySelector('[name="mixed_products"]').value,
+        excluded_categories: Array.from(panel.querySelectorAll('[name="excluded_categories"]:checked')).map(function (box) { return box.value; }),
+        required_keywords: panel.querySelector('[name="required_keywords"]').value,
+        blocked_keywords: panel.querySelector('[name="blocked_keywords"]').value
+      };
+    }
+    var token = form.querySelector('[name="_csrf_token"]');
+    if (!token) { result.textContent = 'Reload this page to renew its security token.'; return; }
+    draft.disabled = saved.disabled = true;
+    result.textContent = 'Checking product preferences locally…';
+    try {
+      var response = await fetch('{{ url_for("category_preview_api") }}', {
+        method: 'POST', credentials: 'same-origin',
+        headers: {'Content-Type': 'application/json', 'X-CSRF-Token': token.value},
+        body: JSON.stringify(payload)
+      });
+      var data = await response.json();
+      if (!response.ok || !data.ok) { throw new Error(data.error || 'Preview unavailable'); }
+      var p = data.preview;
+      var lines = [(useSaved ? 'SAVED rules' : 'UNSAVED choices') + ' · ' + p.mode,
+        p.passes ? '✅ Product preferences: ALLOW' : '⏸ Product preferences: HOLD', p.reason];
+      if (p.categories) { lines.push('Detected: ' + p.categories.join(', ')); }
+      Object.keys(p.evidence || {}).forEach(function (key) { lines.push('• ' + key + ': ' + p.evidence[key].join(', ')); });
+      lines.push('No message was sent. No preferences were saved. Offline rules are not catalogue verification.');
+      result.textContent = lines.join('\n');
+    } catch (error) { result.textContent = 'Could not preview: ' + error.message; }
+    finally { draft.disabled = saved.disabled = false; }
+  }
+  draft.addEventListener('click', function () { check(false); });
+  saved.addEventListener('click', function () { check(true); });
+})();
+</script>
