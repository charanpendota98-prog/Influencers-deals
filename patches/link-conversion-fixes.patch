+def test_unmonetised_links_reports_merchant_failures_not_by_design_meesho():
+    rendered = (
+        "🔥 https://www.flipkart.com/p/itm123\n"
+        "🛍️ https://www.meesho.com/s/p/7amuq5"
+    )
+    audit = commission_guard.audit_rendered_text(
