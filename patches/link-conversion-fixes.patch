+        replacement = replacements.get(url)
+        if not replacement:
+            continue
+        out = out[:start] + replacement + out[end:]
+
+    deduped: list[str] = []
+    for url in unresolved:
+        if url not in deduped:
+            deduped.append(url)
+    return out, deduped
