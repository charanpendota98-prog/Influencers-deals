+    ttl = _RESOLVE_CACHE_TTL if final else _RESOLVE_CACHE_NEGATIVE_TTL
+    if time.time() - stored_at > ttl:
+        _RESOLVED_CACHE.pop(url, None)
+        return False, None
+    return True, final
