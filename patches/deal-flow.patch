+    deals_seen        INTEGER NOT NULL DEFAULT 0,
+    posts_dispatched  INTEGER NOT NULL DEFAULT 0,
+    failures          INTEGER NOT NULL DEFAULT 0,
+    last_error        TEXT NOT NULL DEFAULT '',
+    updated_at        TEXT NOT NULL DEFAULT (datetime('now'))
+);
