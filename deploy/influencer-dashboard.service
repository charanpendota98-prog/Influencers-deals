[Unit]
Description=Influencer Hub — Flask dashboard
After=network.target influencer-wa-hub.service

[Service]
Type=simple
WorkingDirectory=/home/user/Influencers-deals/dashboard
ExecStart=/home/user/Influencers-deals/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
Environment=PYTHONPATH=/home/user/Influencers-deals
EnvironmentFile=/home/user/Influencers-deals/.env

[Install]
WantedBy=multi-user.target
