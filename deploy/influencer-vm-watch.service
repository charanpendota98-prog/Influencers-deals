[Unit]
Description=Influencer Hub — VM/bot health watcher
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/.venv/bin/python -m influencer_hub.cli vm-watch --loop
Restart=on-failure
RestartSec=10
Environment=PYTHONPATH=@REPO_ROOT@
EnvironmentFile=-@REPO_ROOT@/.env
UMask=0077

[Install]
WantedBy=multi-user.target
