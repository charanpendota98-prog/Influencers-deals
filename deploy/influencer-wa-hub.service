[Unit]
Description=Influencer Hub — WhatsApp multi-session service (baileys)
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@/wa_hub
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-@REPO_ROOT@/.env
UMask=0077

[Install]
WantedBy=multi-user.target
